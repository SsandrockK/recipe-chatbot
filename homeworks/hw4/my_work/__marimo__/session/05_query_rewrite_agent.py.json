          "type": "data",
          "data": {
            "text/markdown": "<span class=\"markdown prose dark:prose-invert contents\"><h2 id=\"step-2-test-on-a-single-query\">Step 2: Test on a Single Query</h2>\n<span class=\"paragraph\">Let's test all three strategies on one query to see how they work!</span></span>"
          }
